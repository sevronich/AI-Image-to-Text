{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chitra: Start app and model",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Start-Qwen.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Chitra: Stop app and model",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Stop-Chitra.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Chitra: Test",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Chitra: Build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
